# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# supabase CLI link/db push 시 사용
SUPABASE_DB_PASSWORD=

# === Embedding (OpenAI) — 색인 + query 임베딩 ===
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# === Rerank (Cohere) — 1차 검색 후 cross-encoder 재정렬 ===
# https://dashboard.cohere.com/api-keys
# OpenAI / Anthropic 은 Rerank API 미제공 → Cohere 또는 Voyage 양자택일
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# === LLM (Anthropic) — Tool Use, 답변 생성 ===
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# === 법제처 OpenAPI ===
# open.law.go.kr 가입 후 발급
LAW_GO_KR_API_KEY=
LAW_GO_KR_BASE_URL=https://www.law.go.kr/DRF/lawSearch.do

# === RAG 검색 파라미터 ===
RETRIEVAL_TOP_K=30
RERANK_TOP_K=8
# 관련도 분기 기준치 (rerank 최상위 relevanceScore, 0~1). 미만이면 법제처 폴백.
RELEVANCE_THRESHOLD=0.15

# === 크롤러 ===
CRAWLER_USER_AGENT=PIMS-Crawler/1.0
CRAWLER_TIMEOUT_MS=10000

# === 관리자(/admin) ===
# 아이디+비밀번호 둘 다 프로덕션 필수. 비밀번호는 세션 쿠키 서명키도 겸한다.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# /api/ingest 관리자 시크릿. 미설정 시 ingest 항상 차단(외부 노출 금지). 배포 시 랜덤값으로 설정.
INGEST_SECRET=
