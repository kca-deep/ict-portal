# ============================================================================
# PIMS 환경변수 템플릿 (.env.example — 값을 채워 .env.local 로 복사)
# 그룹 순서: Supabase → AI(임베딩·재정렬·LLM) → 외부 공공 API → RAG 파라미터
# → 입력 캡 → 레이트리밋·비용가드 → 알림 → 크롤러 → 관리자·보안
# ============================================================================

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# supabase CLI link/db push 시 사용
SUPABASE_DB_PASSWORD=

# === 임베딩 (OpenAI) — 색인 + query 임베딩 ===
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# === 재정렬 (Cohere) — 1차 검색 후 cross-encoder 재정렬 ===
# https://dashboard.cohere.com/api-keys
# OpenAI / Anthropic 은 Rerank API 미제공 → Cohere 또는 Voyage 양자택일
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# === LLM (Anthropic) — 답변 생성 + 의도 분해 게이트 ===
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# 의도 분해 게이트 전용 소형 모델(답변 LLM 과 분리)
INTENT_MODEL=claude-haiku-4-5

# === 외부 공공 API ===
# 법제처 OpenAPI — open.law.go.kr 가입 후 발급
LAW_GO_KR_API_KEY=
LAW_GO_KR_BASE_URL=https://www.law.go.kr/DRF/lawSearch.do
# 공공데이터포털 특일정보(관리자 대시보드 "쉬는 날" 지표) — data.go.kr 한국천문연구원
# 특일 정보(getRestDeInfo) 활용신청 후 발급. 디코딩(평문) 서비스키 사용.
# 미설정 시 주말만 쉬는 날로 폴백(공휴일 미반영).
DATA_GO_KR_API_KEY=

# === RAG 검색 파라미터 ===
RETRIEVAL_TOP_K=30
RERANK_TOP_K=8
# 관련도 분기 기준치 (rerank 최상위 relevanceScore, 0~1). 미만이면 법제처 폴백.
RELEVANCE_THRESHOLD=0.15
# 복합 질의 의도별 상위 2건에 적용하는 완화 문턱(B안)
RELEVANCE_INTENT_FLOOR=0.25

# === 입력 캡 (비용/남용 방지) ===
MAX_TURNS=30
MAX_CONTENT_CHARS=8000

# === 레이트리밋·비용가드 (Upstash Redis) — 프로덕션 필수 ===
# 공개(no-login) 챗 엔드포인트의 핵심 방어선. Upstash 콘솔(console.upstash.com)
# 에서 Redis DB 생성 후 REST URL/TOKEN 발급. 프로덕션은 미설정 시 부팅 실패.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 프로덕션 기본 활성("false" 로만 해제), 로컬은 opt-in("true")
RATE_LIMIT_ENABLED=
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_IP_DAILY_CAP=500
RATE_LIMIT_DAILY_CAP=2000
# 일일 토큰 예산(입력+출력, 보조 LLM·임베딩 포함). 초과 시 429.
COST_IP_DAILY_TOKENS=200000
COST_GLOBAL_DAILY_TOKENS=5000000
# 예산 대비 이 비율 초과 시 관리자 이메일 경고(하루 1회). 0~1.
ALERT_COST_THRESHOLD=0.8

# === 알림 (Resend 이메일) — 선택, 미설정 시 no-op ===
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# === 크롤러 ===
CRAWLER_USER_AGENT=PIMS-Crawler/1.0
CRAWLER_TIMEOUT_MS=10000

# === 배포 출처 (CORS·CSP) — 선택 ===
# 교차 출처 허용 목록(쉼표 구분). 이 앱은 fetch 가 전부 상대경로(동일 출처)라 미설정으로도
# 프로덕션 정상 동작. 다른 출처에서 API 를 부르는 구성이 생길 때만 설정.
# Vercel 기본 도메인 사용 시 예: https://<프로젝트>.vercel.app
ALLOWED_ORIGINS=

# === 관리자 · 보안 하드닝 ===
# 관리자 계정 — 아이디+비밀번호 둘 다 프로덕션 필수. 비밀번호는 세션 서명키 폴백도 겸한다.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 관리자 세션 서명키 — 선택. 미설정 시 ADMIN_PASSWORD 폴백(비번 변경=세션 무효화).
ADMIN_SESSION_SECRET=
# 관리자 접속 허용 IP — 쉼표 구분 IPv4 단일/CIDR (예: 203.0.113.10,198.51.100.0/29).
# 프로덕션에서 미설정이면 관리자 표면(/admin·/api/admin) 전체 404(기본 거부).
# 기관 고정 IP(SSLVPN egress) 기준. 로컬 개발은 검사 생략.
ADMIN_ALLOWED_IPS=
# 관리자 화면 시크릿 슬러그 — 설정 시 /{slug}/* 로만 접근, /admin 직접 접근은 404 은닉.
# URL-safe 문자만(영숫자·-·_). 예: openssl rand -hex 16 결과값. 미설정이면 /admin 유지.
ADMIN_PATH_SECRET=
# /api/ingest 관리자 시크릿. 미설정 시 ingest 항상 차단(외부 노출 금지). 배포 시 랜덤값으로 설정.
INGEST_SECRET=
