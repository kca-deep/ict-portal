# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# supabase CLI link/db push 시 사용
SUPABASE_DB_PASSWORD=

# === Embedding (OpenAI) — 색인 + query 임베딩 ===
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# === Rerank (Cohere) — 1차 검색 후 cross-encoder 재정렬 ===
# https://dashboard.cohere.com/api-keys
# OpenAI / Anthropic 은 Rerank API 미제공 → Cohere 또는 Voyage 양자택일
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# === LLM (답변 생성) ===
# provider 토글: anthropic(기본) | openai. 부팅 시 하나 선택(정적). 두 키는 어차피 상시 필요.
LLM_PROVIDER=anthropic
# anthropic provider 모델
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# openai provider 모델(LLM_PROVIDER=openai 일 때). gpt-5 계열은 추론 모델.
# reasoning_effort 는 gpt-5/o-series 에만 적용 — minimal 이 스트리밍 첫토큰 지연 최소.
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=low

# === 법제처 OpenAPI ===
# open.law.go.kr 가입 후 발급
LAW_GO_KR_API_KEY=
LAW_GO_KR_BASE_URL=https://www.law.go.kr/DRF/lawSearch.do

# === RAG 검색 파라미터 ===
RETRIEVAL_TOP_K=30
RERANK_TOP_K=8
# 관련도 분기 기준치 (rerank 최상위 relevanceScore, 0~1). 미만이면 법제처 폴백.
RELEVANCE_THRESHOLD=0.15

# === 크롤러 ===
CRAWLER_USER_AGENT=PIMS-Crawler/1.0
CRAWLER_TIMEOUT_MS=10000

# === 보안/공개 오픈 ===
# Turnstile 봇 게이트. 둘 다 채우면 활성. "false" 면 강제 OFF. 미설정이면 게이트 없음(기존 동작).
TURNSTILE_ENABLED=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 챗 입력 가드
MAX_TURNS=30
MAX_CONTENT_CHARS=8000
# 레이트리밋(기본 OFF). "true" 로 활성.
RATE_LIMIT_ENABLED=
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_DAILY_CAP=2000
# ingest 관리자 시크릿(미설정 시 /api/ingest 차단). 적재 스크립트는 x-ingest-secret 헤더로 전송.
INGEST_SECRET=
