# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# supabase CLI link/db push 시 사용
SUPABASE_DB_PASSWORD=

# === Embedding (OpenAI) — 색인 + query 임베딩 ===
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# === Rerank (Cohere) — 1차 검색 후 cross-encoder 재정렬 ===
# https://dashboard.cohere.com/api-keys
# OpenAI / Anthropic 은 Rerank API 미제공 → Cohere 또는 Voyage 양자택일
COHERE_API_KEY=
RERANK_MODEL=rerank-v4.0

# === LLM (Anthropic) — Tool Use, 답변 생성 ===
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# === 법제처 OpenAPI ===
# open.law.go.kr 가입 후 발급
LAW_GO_KR_API_KEY=
LAW_GO_KR_BASE_URL=https://www.law.go.kr/DRF/lawSearch.do

# === RAG 검색 파라미터 ===
RETRIEVAL_TOP_K=30
RERANK_TOP_K=8

# === 크롤러 ===
CRAWLER_USER_AGENT=PIMS-Crawler/1.0
CRAWLER_TIMEOUT_MS=10000
